Description: Replace std::vector::append_range with insert() for gcc 14
 std::vector::append_range is C++23 (P1206), but it is only implemented in
 libstdc++ 15 and newer, so the build fails with gcc 14:
 "class std::vector<CConfigManager::SSetting> has no member named
 'append_range'".
 .
 Append the elements with insert() and move iterators instead, which is
 equivalent and works on both gcc 14 and 15+.
Origin: Parrot
Forwarded: not-needed
Last-Update: 2026-11-20
Index: hyprpaper-0.8.5/src/config/WallpaperMatcher.cpp
===================================================================
--- hyprpaper-0.8.5.orig/src/config/WallpaperMatcher.cpp
+++ hyprpaper-0.8.5/src/config/WallpaperMatcher.cpp
@@ -1,6 +1,7 @@
 #include "WallpaperMatcher.hpp"
 
 #include <algorithm>
+#include <iterator>
 
 using namespace std::string_literals;
 
@@ -26,7 +27,7 @@ void CWallpaperMatcher::addStates(std::v
     }
 
     std::erase_if(m_settings, [&s](const auto& e) { return std::ranges::any_of(s, [&e](const auto& el) { return el.monitor == e.monitor; }); });
-    m_settings.append_range(std::move(s));
+    m_settings.insert(m_settings.end(), std::make_move_iterator(s.begin()), std::make_move_iterator(s.end()));
     recalcStates();
 }
 
